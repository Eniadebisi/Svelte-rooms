generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  password    String
  name        String
  roleTemp    Int           @default(0)
  role        Roles         @default(Restricted)
  Reservation Reservation[]
}

enum Roles {
  Owner
  Admin
  User
  Guest
  Restricted
}

model Room {
  id           Int           @id @default(autoincrement())
  name         String
  size         Int
  locationId   Int
  details      String
  reservations Reservation[]
  location     Location      @relation(fields: [locationId], references: [id])

  @@index([locationId], map: "Room_locationId_fkey")
}

model Reservation {
  id         Int         @id @default(autoincrement())
  roomId     Int
  userId     Int
  startTime  DateTime
  details    String      @db.VarChar(200)
  length     Int?
  title      String      @db.VarChar(50)
  endTime    DateTime
  RecurrencePattern String?
  Room       Room        @relation(fields: [roomId], references: [id])
  user       User        @relation(fields: [userId], references: [id])

  @@index([roomId], map: "Reservation_roomId_fkey")
  @@index([userId], map: "Reservation_userId_fkey")
}

model Location {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  rooms Room[]
}