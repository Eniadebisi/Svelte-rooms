{
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  },
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["types/**/*.d.ts", "prisma.config.ts", "app"]
}
