SITE_NAME="My Site"

# Prisma CLI (migrations, studio)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Runtime DB connection (used by db.ts)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="DATABASE"
DB_USER="USER"
DB_PASSWORD="PASSWORD"

JWT_ACCESS_SECRET="change-me-to-a-long-random-secret"

# DEVELOPMENT skips JWT verification; any other value enforces it
MODE="DEVELOPMENT"
NODE_ENV="development"

TIME_ZONE="America/New_York"

# Contact email shown to users (can be an alias on contact or same as contact)
CONTACT_EMAIL="contact@yourdomain.com"

# Auth email used
AUTH_EMAIL="noreply@yourdomain.com"
AUTH_EMAIL_PW="your-email-password"
SMTP_HOST="your.smtp.host"
SMTP_PORT="000"