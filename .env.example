# Prisma CLI (migrations, studio)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Runtime DB connection (used by db.ts)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="DATABASE"
DB_USER="USER"
DB_PASSWORD="PASSWORD"

JWT_ACCESS_SECRET="change-me-to-a-long-random-secret"

# DEVELOPMENT skips JWT verification; any other value enforces it
MODE="DEVELOPMENT"
NODE_ENV="development"

# Auth email used
AUTH_EMAIL="noreply@yourdomain.com"
AUTH_EMAIL_PW="your-email-password"