# Database (MySQL — used by Prisma)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# JWT signing secret — use a long random string in production
JWT_ACCESS_SECRET="change-me-to-a-long-random-secret"

# Set to DEVELOPMENT to skip JWT verification locally
# Set to PRODUCTION (or any other value) to enforce JWT in production
MODE="DEVELOPMENT"

# Node environment
NODE_ENV="development"

# Nodemailer / Titan SMTP credentials (smtp.titan.email)
EMAIL_PASSWORD="your-titan-email-password"